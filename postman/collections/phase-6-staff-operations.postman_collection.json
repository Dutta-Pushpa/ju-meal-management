        {
          "name": "Create a budget period",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const DAY = 86400000;",
                  "// This phase owns a second budget window, 400 days clear of Phase 5's,",
                  "// so the two phases can run back to back without overlapping periods.",
                  "const offsetDays = 20000 + (Math.floor(Date.now() / 1000) % 10000) * 30 + 400;",
                  "const start = new Date(Date.UTC(2026, 0, 1) + offsetDays * DAY);",
                  "const end = new Date(start.getTime() + 6 * DAY);",
                  "const order = new Date(start.getTime() + 2 * DAY);",
                  "const iso = (date) => date.toISOString().slice(0, 10);",
                  "pm.variables.set('periodStartsOn', iso(start));",
                  "pm.variables.set('periodEndsOn', iso(end));",
                  "pm.variables.set('orderDate', iso(order));",
                  "pm.variables.set('periodName', 'Newman ' + iso(start));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('returns the created period', () => {",
                  "  pm.expect(b.data.startsOn).to.eql(pm.variables.get('periodStartsOn'));",
                  "  pm.expect(b.data.endsOn).to.eql(pm.variables.get('periodEndsOn'));",
                  "});",
                  "pm.environment.set('periodId', String(b.data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{periodName}}\",\n  \"startsOn\": \"{{periodStartsOn}}\",\n  \"endsOn\": \"{{periodEndsOn}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/staff/budget-periods",
              "host": ["{{baseUrl}}"],
              "path": ["api", "staff", "budget-periods"]
            }
          }
        },
