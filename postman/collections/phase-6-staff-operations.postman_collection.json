  "info": {
    "name": "Phase 6 — Staff operations and reporting",
    "description": "Phase 6: the daily staff dashboard, collection and delivery status changes, daily and budget reports, settings, and user administration.\n\nSelf-contained. Run it with `npm run test:api:phase6` against a migrated and seeded database.",
