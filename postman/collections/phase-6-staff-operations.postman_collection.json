                  "});",
                  "pm.test('computes the total from the line items', () => pm.expect(b.data.total.amountPaisa).to.eql(line.unitPrice.amountPaisa * line.quantity));",
                  "pm.environment.set('orderId', String(b.data.id));",
                  "pm.environment.set('orderItemId', String(line.id));"
