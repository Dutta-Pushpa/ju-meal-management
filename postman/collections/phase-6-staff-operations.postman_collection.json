    {
      "name": "03 Reports",
      "item": [
        {
          "name": "Daily report for the order date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('returns the requested date', () => pm.expect(d.date).to.eql(pm.variables.get('orderDate')));",
                  "pm.test('includes the non-cancelled order', () => pm.expect(d.dailyTotal.amountPaisa).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
