# Normalise line endings so migrations, seed scripts, and shell tooling behave
# identically on Windows, macOS, and Linux.
* text=auto eol=lf

*.sql   text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.jmx   text eol=lf
*.env   text eol=lf