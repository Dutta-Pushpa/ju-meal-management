{
  "name": "ju-meal-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meal ordering and food-collection platform for JU CSE teachers",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:shared": "npm run build --workspace shared",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:status": "tsx db/migrate.ts status",
    "db:seed": "tsx db/seed.ts",
    "test": "npm run test --workspace server",
    "test:watch": "npm run test:watch --workspace server",
    "test:coverage": "npm run test:coverage --workspace server",
    "test:api": "node scripts/api-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspace shared && npm run typecheck --workspace server && tsc --noEmit -p db/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "newman": "6.2.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
