# Copy to .env and fill in real values. Never commit .env.
# Every variable below is validated at startup. The server refuses to boot if a
# required variable is missing or malformed, rather than failing later on the
# first request that needs it.
#
# Variables with built-in defaults (JWT_EXPIRES_IN_MINUTES, BCRYPT_COST,
# APP_TIMEZONE, ORDER_CUTOFF_TIME, BUDGET_ROLLOVER,
# DEFAULT_WEEKLY_BUDGET_PAISA, CORS_ORIGIN, TRUST_PROXY, the RATE_LIMIT_* set,
# LOG_LEVEL, LOG_PRETTY) are omitted on purpose: server/src/config/env.ts
# supplies the same defaults. Add one back only to override it.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- database
# The API's runtime connection. For a shared Neon database use the POOLED
# string (its host contains "-pooler"); for local Docker use the localhost URL
# shown at the bottom of this file.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Used by `npm run db:migrate` and `npm run db:seed`. May be omitted when it is
# identical to DATABASE_URL. For Neon, point this at the DIRECT (non-pooled)
# string: migrations hold a session-level advisory lock and run multi-statement
# transactions, which a transaction pooler cannot keep across statements.
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Local Docker example (no separate admin URL needed):
# DATABASE_ADMIN_URL=postgresql://ju_meal:ju_meal_dev_password@localhost:5432/postgres

# Connection pool sizing. The pool never exceeds the PostgreSQL
# max_connections setting.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# Require TLS. true for any managed provider (Neon included); a Neon URL
# already carries sslmode=require, so this is belt-and-braces. The server
# refuses to start in production unless this is true. Local Docker uses false.
DB_SSL=true

# ---------------------------------------------------------------- docker compose
# Read only by docker-compose.yml to run the local test database. The server
# never reads these.
POSTGRES_DB=ju_meal
POSTGRES_USER=ju_meal
POSTGRES_PASSWORD=ju_meal_dev_password
# Change only if port 5432 is already taken on this machine.
POSTGRES_PORT=5432

# ---------------------------------------------------------------- authentication
# Must be at least 32 characters. The server refuses to start in production if
# this is still the example value.
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
