# Copy to .env and fill in real values. Never commit .env.
# Every variable below is validated at startup. The server refuses to boot if a
# required variable is missing or malformed, rather than failing later on the
# first request that needs it.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- database
# Used by the API at runtime.
DATABASE_URL=postgresql://ju_meal:ju_meal_dev_password@localhost:5432/ju_meal

# Used by `npm run db:migrate` and `npm run db:seed`. May be omitted if it is
# identical to DATABASE_URL.
# DATABASE_ADMIN_URL=postgresql://ju_meal:ju_meal_dev_password@localhost:5432/postgres

# Connection pool sizing. The pool never exceeds the PostgreSQL
# max_connections setting.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false

# ---------------------------------------------------------------- docker compose
POSTGRES_DB=ju_meal
POSTGRES_USER=ju_meal
POSTGRES_PASSWORD=ju_meal_dev_password
# Change only if port 5432 is already taken on this machine.
POSTGRES_PORT=5432

# ---------------------------------------------------------------- authentication
# Must be at least 32 characters. The server refuses to start in production if
# this is still the example value.
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_MINUTES=15

# bcrypt work factor. Higher is slower and safer. 12 is a reasonable balance on
# a university server; raise it as hardware improves. Existing hashes are
# upgraded to the current cost the next time that user logs in.
BCRYPT_COST=12

# ---------------------------------------------------------------- business rules
# Business timezone. The 12:00 PM ordering cutoff is evaluated in this zone.
APP_TIMEZONE=Asia/Dhaka
ORDER_CUTOFF_TIME=12:00
# When false, unspent budget does not carry into the next period.
BUDGET_ROLLOVER=false
# Weekly allocation seeded for demo teachers, in paisa. 70000 = ৳700.00
DEFAULT_WEEKLY_BUDGET_PAISA=70000

# ---------------------------------------------------------------- http
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# ---------------------------------------------------------------- rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# ---------------------------------------------------------------- logging
# One of: fatal, error, warn, info, debug, trace. Silent is accepted for tests.
LOG_LEVEL=info
# Pretty single-line output for development. Always false in production.
LOG_PRETTY=true